{
  "name": "copy-branch-name",
  "type": "module",
  "displayName": "Copy Branch Name",
  "description": "Extension to copy the current branch name",
  "publisher": "PKief",
  "author": {
    "name": "Philipp Kief",
    "email": "philipp.kief@gmx.de",
    "url": "https://pkief.com"
  },
  "version": "1.2.0",
  "engines": {
    "vscode": "^1.69.0"
  },
  "keywords": [
    "git",
    "branch"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "funding": "https://github.com/sponsors/PKief",
  "sponsor": {
    "url": "https://github.com/sponsors/PKief"
  },
  "homepage": "https://github.com/PKief/vscode-copy-branch-name/blob/main/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/PKief/vscode-copy-branch-name.git"
  },
  "bugs": {
    "url": "https://github.com/PKief/vscode-copy-branch-name/issues"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "copy-branch-name.copy-current",
        "title": "Copy current branch name",
        "icon": "$(copy)",
        "shortTitle": "Copy current branch name"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "esbuild src/extension.ts --bundle --minify --platform=node --target=node16 --format=cjs --external:vscode --outfile=dist/extension.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/vscode": "~1.69.0",
    "changelog-machine": "^2.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
